---
import Layout from '../layouts/Layout.astro';
import { Hammer } from 'lucide-astro';
---

<Layout>
	<main class="min-h-screen flex flex-col items-center justify-center p-4 text-center">
		<Hammer class="w-16 h-16 text-accent-orange mb-6" />
		<h1 class="text-4xl md:text-5xl font-bold mb-4">Orrego Servicios</h1>
		<p class="text-lg text-slate-300 max-w-xl mx-auto">
			Plataforma en construcción. Especialistas en obras menores, climatización, redes eléctricas y sanitarias generales.
		</p>
	</main>
</Layout>
