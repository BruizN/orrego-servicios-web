---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Hero from '../components/Hero.astro';
import Services from '../components/Services.astro';
import ValueProps from '../components/ValueProps.astro';
import B2BSection from '../components/B2BSection.astro';
import FAQ, { FAQ_ITEMS } from '../components/FAQ.astro';
import QuoteForm from '../components/QuoteForm.astro';
import Footer from '../components/Footer.astro';

// Schema FAQPage estructurado para snippets enriquecidos en Google
const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": FAQ_ITEMS.map((item) => ({
    "@type": "Question",
    "name": item.question,
    "acceptedAnswer": {
      "@type": "Answer",
      "text": item.answer
    }
  }))
};
---

<Layout jsonLd={faqSchema}>
	<Header />
	<main>
		<Hero />
		<Services />
		<ValueProps />
		<B2BSection />
		<FAQ />
		<QuoteForm />
	</main>
	<Footer />
</Layout>
