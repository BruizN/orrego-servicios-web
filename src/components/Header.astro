---
import { Wrench } from '@lucide/astro';
---

<header class="fixed w-full top-0 z-50 bg-dark-950/80 backdrop-blur-md border-b border-white/10">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="flex justify-between items-center h-20">
      <div class="flex items-center gap-2">
        <div class="bg-accent-orange p-2 rounded-lg">
          <Wrench class="w-6 h-6 text-white" />
        </div>
        <span class="text-xl font-bold tracking-tight text-white">
          Orrego<span class="text-accent-cyan">Servicios</span>
        </span>
      </div>
      
      <nav class="hidden md:flex items-center gap-8">
        <a href="#servicios" class="text-slate-300 hover:text-white transition-colors">Servicios</a>
        <a href="#nosotros" class="text-slate-300 hover:text-white transition-colors">Experiencia</a>
        <a href="#cotizar" class="px-5 py-2.5 rounded-full bg-accent-orange text-white font-medium hover:bg-orange-600 transition-all shadow-[0_0_15px_rgba(255,87,34,0.3)]">
          Cotizar Ahora
        </a>
      </nav>
    </div>
  </div>
</header>
