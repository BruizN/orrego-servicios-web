---
import { AlertTriangle } from '@lucide/astro';
---

<!-- 
  Botón flotante SOS
  En el MVP inicial solo abrirá un modal (que armaremos en el siguiente paso),
  pero lo dejamos anclado en la esquina inferior derecha.
-->
<button 
  id="sos-button"
  class="fixed bottom-6 right-6 z-50 flex items-center justify-center w-16 h-16 rounded-full bg-accent-red text-white shadow-[0_0_20px_rgba(239,68,68,0.6)] hover:scale-110 hover:bg-red-600 transition-all group animate-pulse hover:animate-none"
  aria-label="Emergencia 24/7"
>
  <AlertTriangle class="w-8 h-8 group-hover:scale-110 transition-transform" />
  
  <!-- Tooltip emergente al hacer hover -->
  <span class="absolute right-20 bg-dark-800 text-white text-sm font-bold px-4 py-2 rounded-lg border border-accent-red/30 opacity-0 group-hover:opacity-100 transition-opacity whitespace-nowrap pointer-events-none">
    URGENCIA 24/7
  </span>
</button>

<!-- 
  Script nativo para manejar el click
  (Preparado para abrir el modal en el próximo PR)
-->
<script>
  const sosButton = document.getElementById('sos-button');
  if (sosButton) {
    sosButton.addEventListener('click', () => {
      console.log('Abrir modal SOS 24/7...');
      // Aquí agregaremos la lógica del modal en el siguiente paso
    });
  }
</script>
