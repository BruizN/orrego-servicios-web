---
import { Building2, Home, AlertCircle, CheckCircle2, ChevronRight } from '@lucide/astro';
import { COMUNAS_RM } from '../utils/comunas';
---

<section id="cotizar" class="py-20 bg-dark-950 relative">
  <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10">
    <div class="text-center mb-12">
      <h2 class="text-3xl md:text-4xl font-bold text-white mb-4">Solicita tu Evaluación</h2>
      <p class="text-slate-400 text-lg">Completa los datos para agendar una visita técnica o recibir una pre-cotización.</p>
    </div>

    <div class="bg-dark-800 border border-white/10 rounded-2xl p-6 md:p-10 shadow-xl backdrop-blur-md">
      
      <!-- Selector B2C / B2B -->
      <div class="flex flex-col sm:flex-row gap-4 mb-8">
        <button id="btn-b2c" class="flex-1 flex items-center justify-center gap-3 py-4 rounded-xl border-2 border-accent-cyan bg-accent-cyan/10 text-white font-bold transition-all">
          <Home class="w-6 h-6 text-accent-cyan" />
          Hogar / Particular
        </button>
        <button id="btn-b2b" class="flex-1 flex items-center justify-center gap-3 py-4 rounded-xl border-2 border-transparent bg-white/5 text-slate-400 hover:text-white hover:bg-white/10 transition-all">
          <Building2 class="w-6 h-6" />
          Empresa / B2B
        </button>
      </div>

      <!-- Alerta de Calefont (Oculta por defecto) -->
      <div id="calefont-alert" class="hidden mb-8 p-4 rounded-xl bg-accent-red/10 border border-accent-red/30 flex items-start gap-3">
        <AlertCircle class="w-6 h-6 text-accent-red flex-shrink-0 mt-0.5" />
        <div>
          <h4 class="text-accent-red font-bold mb-1">Servicio no disponible</h4>
          <p class="text-sm text-slate-300 leading-relaxed">
            En Orrego Servicios nos especializamos en obras menores, climatización, redes eléctricas y sanitarias generales. Para trabajos de calefonts y gas de alta presión, te recomendamos acudir a un instalador certificado por la SEC.
          </p>
        </div>
      </div>

      <form id="quote-form" class="space-y-6">
        
        <!-- Campos comunes -->
        <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
          <div id="field-name">
            <label class="block text-sm font-medium text-slate-400 mb-2">Nombre completo *</label>
            <input type="text" id="q-name" required class="w-full bg-dark-950 border border-white/10 rounded-lg px-4 py-3 text-white focus:outline-none focus:border-accent-cyan transition-colors" />
          </div>
          <div id="field-phone">
            <label class="block text-sm font-medium text-slate-400 mb-2">Teléfono (+56 9 ...) *</label>
            <input type="tel" id="q-phone" required placeholder="+56 9 " class="w-full bg-dark-950 border border-white/10 rounded-lg px-4 py-3 text-white focus:outline-none focus:border-accent-cyan transition-colors" />
          </div>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
          <div id="field-commune">
            <label class="block text-sm font-medium text-slate-400 mb-2">Comuna *</label>
            <select id="q-commune" required class="w-full bg-dark-950 border border-white/10 rounded-lg px-4 py-3 text-white focus:outline-none focus:border-accent-cyan transition-colors">
              <option value="" disabled selected>Selecciona tu comuna...</option>
              {COMUNAS_RM.map((comuna) => (
                <option value={comuna}>{comuna}</option>
              ))}
            </select>
          </div>
          
          <!-- Campos específicos B2B -->
          <div id="field-b2b-company" class="hidden">
            <label class="block text-sm font-medium text-slate-400 mb-2">Razón Social *</label>
            <input type="text" id="q-company" class="w-full bg-dark-950 border border-white/10 rounded-lg px-4 py-3 text-white focus:outline-none focus:border-accent-orange transition-colors" />
          </div>
        </div>

        <div id="b2b-extra-fields" class="hidden grid-cols-1 md:grid-cols-2 gap-6">
          <div>
            <label class="block text-sm font-medium text-slate-400 mb-2">RUT Empresa *</label>
            <input type="text" id="q-rut" class="w-full bg-dark-950 border border-white/10 rounded-lg px-4 py-3 text-white focus:outline-none focus:border-accent-orange transition-colors" />
          </div>
          <div>
            <label class="block text-sm font-medium text-slate-400 mb-2">Giro *</label>
            <input type="text" id="q-giro" class="w-full bg-dark-950 border border-white/10 rounded-lg px-4 py-3 text-white focus:outline-none focus:border-accent-orange transition-colors" />
          </div>
          <div class="md:col-span-2 flex items-center gap-3 mt-2">
            <input type="checkbox" id="q-invoice" class="w-5 h-5 rounded border-white/10 bg-dark-950 text-accent-orange focus:ring-accent-orange focus:ring-offset-dark-800" />
            <label for="q-invoice" class="text-slate-300">Requiere emisión de Factura</label>
          </div>
        </div>

        <div class="pt-4">
          <label class="block text-sm font-medium text-slate-400 mb-2">Describe tu problema o proyecto *</label>
          <textarea id="q-desc" required rows="4" class="w-full bg-dark-950 border border-white/10 rounded-lg px-4 py-3 text-white focus:outline-none focus:border-accent-cyan transition-colors" placeholder="Ej: Necesito instalar enchufes nuevos..."></textarea>
        </div>

        <div class="pt-6 border-t border-white/10">
          <button type="submit" id="btn-submit" class="w-full sm:w-auto px-8 py-4 bg-accent-cyan hover:bg-cyan-500 text-dark-950 font-bold rounded-xl transition-all shadow-[0_0_15px_rgba(0,229,255,0.3)] flex items-center justify-center gap-2">
            Enviar Solicitud
            <ChevronRight class="w-5 h-5" />
          </button>
        </div>
      </form>
    </div>
  </div>
</section>

<script>
  import { sendQuote, type QuoteData } from '../services/whatsapp';

  const form = document.getElementById('quote-form') as HTMLFormElement;
  const descInput = document.getElementById('q-desc') as HTMLTextAreaElement;
  const submitBtn = document.getElementById('btn-submit') as HTMLButtonElement;
  const alertBox = document.getElementById('calefont-alert');

  // Selectores B2C / B2B
  const btnB2C = document.getElementById('btn-b2c');
  const btnB2B = document.getElementById('btn-b2b');
  const b2bCompanyField = document.getElementById('field-b2b-company');
  const b2bExtraFields = document.getElementById('b2b-extra-fields');
  const nameField = document.getElementById('field-name');

  // Estado del perfil
  let currentProfile: 'B2C' | 'B2B' = 'B2C';

  // Toggle visual y campos
  const setProfile = (profile: 'B2C' | 'B2B') => {
    currentProfile = profile;
    if (profile === 'B2C') {
      // Activar B2C visualmente
      btnB2C?.classList.replace('border-transparent', 'border-accent-cyan');
      btnB2C?.classList.replace('bg-white/5', 'bg-accent-cyan/10');
      btnB2C?.classList.replace('text-slate-400', 'text-white');
      
      // Desactivar B2B
      btnB2B?.classList.replace('border-accent-orange', 'border-transparent');
      btnB2B?.classList.replace('bg-accent-orange/10', 'bg-white/5');
      btnB2B?.classList.replace('text-white', 'text-slate-400');
      
      // Mostrar/Ocultar campos
      nameField?.classList.remove('hidden');
      b2bCompanyField?.classList.add('hidden');
      b2bExtraFields?.classList.replace('grid', 'hidden');
      submitBtn.classList.replace('bg-accent-orange', 'bg-accent-cyan');
      submitBtn.classList.replace('hover:bg-orange-500', 'hover:bg-cyan-500');
      submitBtn.classList.replace('text-white', 'text-dark-950');
      submitBtn.classList.replace('shadow-[0_0_15px_rgba(255,87,34,0.3)]', 'shadow-[0_0_15px_rgba(0,229,255,0.3)]');
      
      // Required logic
      (document.getElementById('q-name') as HTMLInputElement).required = true;
      (document.getElementById('q-company') as HTMLInputElement).required = false;
      (document.getElementById('q-rut') as HTMLInputElement).required = false;
      (document.getElementById('q-giro') as HTMLInputElement).required = false;

    } else {
      // Activar B2B visualmente
      btnB2B?.classList.replace('border-transparent', 'border-accent-orange');
      btnB2B?.classList.replace('bg-white/5', 'bg-accent-orange/10');
      btnB2B?.classList.replace('text-slate-400', 'text-white');
      
      // Desactivar B2C
      btnB2C?.classList.replace('border-accent-cyan', 'border-transparent');
      btnB2C?.classList.replace('bg-accent-cyan/10', 'bg-white/5');
      btnB2C?.classList.replace('text-white', 'text-slate-400');
      
      // Mostrar/Ocultar campos
      nameField?.classList.add('hidden');
      b2bCompanyField?.classList.remove('hidden');
      b2bExtraFields?.classList.replace('hidden', 'grid');
      submitBtn.classList.replace('bg-accent-cyan', 'bg-accent-orange');
      submitBtn.classList.replace('hover:bg-cyan-500', 'hover:bg-orange-500');
      submitBtn.classList.replace('text-dark-950', 'text-white');
      submitBtn.classList.replace('shadow-[0_0_15px_rgba(0,229,255,0.3)]', 'shadow-[0_0_15px_rgba(255,87,34,0.3)]');

      // Required logic
      (document.getElementById('q-name') as HTMLInputElement).required = false;
      (document.getElementById('q-company') as HTMLInputElement).required = true;
      (document.getElementById('q-rut') as HTMLInputElement).required = true;
      (document.getElementById('q-giro') as HTMLInputElement).required = true;
    }
  };

  btnB2C?.addEventListener('click', () => setProfile('B2C'));
  btnB2B?.addEventListener('click', () => setProfile('B2B'));

  // Filtro de Exclusión Activa (Calefonts)
  const FORBIDDEN_WORDS = ['calefont', 'calefon', 'serpentin', 'serpentín', 'piloto de gas'];

  const checkForbiddenWords = (text: string): boolean => {
    const lowerText = text.toLowerCase();
    return FORBIDDEN_WORDS.some(word => lowerText.includes(word));
  };

  descInput?.addEventListener('input', (e) => {
    const text = (e.target as HTMLTextAreaElement).value;
    if (checkForbiddenWords(text)) {
      alertBox?.classList.remove('hidden');
      submitBtn.disabled = true;
      submitBtn.classList.add('opacity-50', 'cursor-not-allowed');
      descInput.classList.add('border-accent-red');
    } else {
      alertBox?.classList.add('hidden');
      submitBtn.disabled = false;
      submitBtn.classList.remove('opacity-50', 'cursor-not-allowed');
      descInput.classList.remove('border-accent-red');
    }
  });

  // Enviar formulario
  form?.addEventListener('submit', (e) => {
    e.preventDefault();
    
    // Doble check por si modificaron el DOM
    if (checkForbiddenWords(descInput.value)) return;

    const data: QuoteData = {
      type: currentProfile,
      phone: (document.getElementById('q-phone') as HTMLInputElement).value,
      commune: (document.getElementById('q-commune') as HTMLSelectElement).value,
      description: descInput.value,
    };

    if (currentProfile === 'B2C') {
      data.name = (document.getElementById('q-name') as HTMLInputElement).value;
    } else {
      data.businessName = (document.getElementById('q-company') as HTMLInputElement).value;
      data.rut = (document.getElementById('q-rut') as HTMLInputElement).value;
      data.businessType = (document.getElementById('q-giro') as HTMLInputElement).value;
      data.requiresInvoice = (document.getElementById('q-invoice') as HTMLInputElement).checked;
    }

    sendQuote(data);
  });
</script>
